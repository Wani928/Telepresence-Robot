}

// ================================================================ Wifi Send/Receive Functions =================================================================================

void receiveUDPData(void) {
  packetSize = udp.parsePacket();  // listens for a packet in UDP comms line and returns its size
  if (packetSize) {                // if a packet has been received
    // Receive incoming UDP packet
    len = udp.read(incomingPacket, 255);  // read packet into array of size 255
    if (len > 0) {
      incomingPacket[len] = 0;  // Null-terminate received data (required for printf/string parsing)
    }

    // Parse the received data
    String receivedData = String(incomingPacket);

    Motor_Direction = receivedData.substring(0, receivedData.indexOf(','));  // Extract before first comma
    int firstComma = receivedData.indexOf(',');                              // Find first comma
    int secondComma = receivedData.indexOf(',', firstComma + 1);             // Find second comma
    speed = receivedData.substring(firstComma + 1, secondComma).toInt();     // Extract speed
    switchState = receivedData.substring(secondComma + 1).toInt();           // Extract switch state

    // Print parsed data
    Serial.print("Motor Direction: ");
    Serial.println(Motor_Direction);
    Serial.print("Speed: ");
    Serial.println(speed);
    Serial.print("Switch State: ");
    Serial.println(switchState);
  }
}

void sendUDPData(void) {
  String data_to_send = String(Distance_A) + "," + String(Distance_B) + "," +
                        String(Battery_Percentage) + "," + String(current_A) + "," +
                        String(current_B);

  udp.beginPacket(udpAddress, udpPort);
  udp.write((const uint8_t*)data_to_send.c_str(), data_to_send.length());  // Cast to uint8_t* for udp.write
  udp.endPacket();
}

void sendUDP_PhoneData(void) {
  String Phone_Data = String(Battery_Percentage) + "," + String(current_A) + "," + String(current_B);

  udp.beginPacket(phoneAddress, udpPort);
  udp.write((const uint8_t*)Phone_Data.c_str(), Phone_Data.length());
  udp.endPacket();
}

// ================================================================ Motor Function =================================================================================

void Motor_Control_2(void) {  // latest version

  if (Motor_Direction == "S") {
    // Set motors to stop
    digitalWrite(MotorA_IN1, LOW);
    digitalWrite(MotorA_IN2, LOW);
    digitalWrite(MotorB_IN3, LOW);
    digitalWrite(MotorB_IN4, LOW);
  }

  if (Motor_Direction == "F") {
    // Set motors to move forward
    digitalWrite(MotorA_IN1, LOW);
    digitalWrite(MotorA_IN2, HIGH);
    digitalWrite(MotorB_IN3, LOW);
    digitalWrite(MotorB_IN4, HIGH);

    // Check distance_A and adjust speed accordingly
    if (Distance_A < 35) {
      // Stop if too close
      digitalWrite(MotorA_IN1, LOW);
      digitalWrite(MotorA_IN2, LOW);
      digitalWrite(MotorB_IN3, LOW);
      digitalWrite(MotorB_IN4, LOW);
    } else if (Distance_A >= 35 && Distance_A <= 65) {
      // Reduce speed when in the caution zone
      Motor_Speed_mapped = map(50, 0, 100, 120, 255);
      Motor_Speed_mapped_B = map(50, 0, 100, 120, 220);
    } else if (Distance_B > 65) {
      // Use normal speed mapping
      Motor_Speed_mapped = map(speed, 0, 100, 120, 255);
      Motor_Speed_mapped_B = map(speed, 0, 100, 120, 220);
    }

    // Set motor speeds
    analogWrite(MotorA_ENA, Motor_Speed_mapped);
    analogWrite(MotorB_ENB, Motor_Speed_mapped_B);

  } else if (Motor_Direction == "B") {
    // Set motors to move backward
    digitalWrite(MotorA_IN1, HIGH);
    digitalWrite(MotorA_IN2, LOW);
    digitalWrite(MotorB_IN3, HIGH);
    digitalWrite(MotorB_IN4, LOW);

    // Check distance_B and adjust speed accordingly
    if (Distance_B < 35) {
      // Stop if too close
      digitalWrite(MotorA_IN1, LOW);
      digitalWrite(MotorA_IN2, LOW);
      digitalWrite(MotorB_IN3, LOW);
      digitalWrite(MotorB_IN4, LOW);
    } else if (Distance_B >= 35 && Distance_B <= 65) {
      // Reduce speed in caution zone
      Motor_Speed_mapped = map(50, 0, 100, 120, 255);
      Motor_Speed_mapped_B = map(50, 0, 100, 120, 235);
    } else if (Distance_B > 65) {
      // Use normal speed mapping
      Motor_Speed_mapped = map(speed, 0, 100, 120, 255);
      Motor_Speed_mapped_B = map(speed, 0, 100, 120, 235);
    }

    analogWrite(MotorA_ENA, Motor_Speed_mapped);
    analogWrite(MotorB_ENB, Motor_Speed_mapped_B);
  }

  else if (Motor_Direction == "R") {
    // Right turn
    digitalWrite(MotorA_IN1, HIGH);
    digitalWrite(MotorA_IN2, LOW);
    digitalWrite(MotorB_IN3, LOW);
    digitalWrite(MotorB_IN4, HIGH);

    Motor_Speed_mapped = map(100, 0, 100, 120, 255);

    analogWrite(MotorA_ENA, Motor_Speed_mapped);
    analogWrite(MotorB_ENB, Motor_Speed_mapped);

  } else if (Motor_Direction == "L") {
    // Left turn
    digitalWrite(MotorA_IN1, LOW);
    digitalWrite(MotorA_IN2, HIGH);
    digitalWrite(MotorB_IN3, HIGH);
    digitalWrite(MotorB_IN4, LOW);

    Motor_Speed_mapped = map(100, 0, 100, 120, 255);

    analogWrite(MotorA_ENA, Motor_Speed_mapped);
    analogWrite(MotorB_ENB, Motor_Speed_mapped);
  }
}

// ================================================================ Object Detection Functions =================================================================================

void Object_Detect_A(void) {
  // Take multiple readings and sum them
  for (int i = 0; i < numReadings_A; i++) {
    // Trigger the ultrasonic sensor
    digitalWrite(trigPin_A, LOW);
    delayMicroseconds(2);
    digitalWrite(trigPin_A, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin_A, LOW);

    // Measure duration of the echo
    duration_A = pulseIn(echoPin_A, HIGH);  // Time in microseconds
    distance_A = (duration_A * Speed) / 2;  // Calculate distance in cm

    // Accumulate distance
    totalDistance_A += distance_A;
  }

  // Calculate the average distance
  Distance_A = totalDistance_A / numReadings_A;
  totalDistance_A = 0;
}

void Object_Detect_B(void) {
  // Take multiple readings and sum them
  for (int i = 0; i < numReadings_B; i++) {
    // Trigger the ultrasonic sensor
    digitalWrite(trigPin_B, LOW);
    delayMicroseconds(2);
    digitalWrite(trigPin_B, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin_B, LOW);

    // Measure duration of the echo
    duration_B = pulseIn(echoPin_B, HIGH);  // Time in microseconds
    distance_B = (duration_B * Speed) / 2;  // Calculate distance in cm

    // Accumulate distance
    totalDistance_B += distance_B;
  }

  // Calculate the average distance
  Distance_B = totalDistance_B / numReadings_B;
  totalDistance_B = 0;
}

// ================================================================ Motor Current Functions =================================================================================

void Motor_Current_A(void) {
  // Take multiple samples
  for (int i = 0; i < numSamples_Motor_A; i++) {
    adcValues_Motor_A[i] = analogRead(ADC_Pin_Motor_A);  // Read ADC
    totalAdcValue_Motor_A += adcValues_Motor_A[i];
  }

  // Calculate average ADC value
  averageAdcValue_Motor_A = totalAdcValue_Motor_A / (float)numSamples_Motor_A;

  // Convert average ADC value to millivolts
  averageVoltage_Motor_A = (averageAdcValue_Motor_A * (3.3 / 4095.0)) * 1000;

  Serial.print("Measured Voltage A: ");
  Serial.print(averageVoltage_Motor_A);

  Serial.print(",  Actual Voltage A: ");

  if (averageAdcValue_Motor_A == 0) {  // Negate calibration offset when ADC is 0
    averageVoltage_Motor_A = 0;
  }

  current_A = int((averageVoltage_Motor_A / 3.0));  // Calculate current
  Serial.print(", Current A: ");
  Serial.println(current_A);

  totalAdcValue_Motor_A = 0;  // Reset accumulator
}

