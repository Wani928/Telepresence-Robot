// ================================================================ Battery Level Functions =================================================================================

void updateBatteryLevel() {
  unsigned long currentTime = millis();

  if (currentTime - lastSampleTime >= SAMPLE_INTERVAL) {
    lastSampleTime = currentTime;

    int newSample = analogRead(ADC_PIN_Battery);
    adcBuffer.push(newSample);

    calculateBatteryLevel();
  }
}

void calculateBatteryLevel() {
  if (adcBuffer.isFull()) {
    totalAdcValue_Battery = 0;  // Reset accumulator
    for (int i = 0; i < BUFFER_SIZE; i++) {
      totalAdcValue_Battery += adcBuffer[i];
    }

    averageAdcValue_Battery = totalAdcValue_Battery / BUFFER_SIZE;

    // Convert ADC value to voltage (account for divider)
    V_Measured_Battery = averageAdcValue_Battery * (3.3 / 4095.0) * ((R1 + R2) / R2);

    if (V_Measured_Battery <= 5.5845401475666972) {  // Lower clamp
      Battery_Percentage = 0;
    } else if (V_Measured_Battery >= 8.307978911905941) {  // Upper clamp
      Battery_Percentage = 100;
    } else {
      for (int i = 0; i < 88; i += 2) {  // Voltage entries are every 2nd element
        if (V_Measured_Battery <= Discharge_Curve[i]) {
          // Linear interpolation between two points
          float lower_soc = Discharge_Curve[i - 1];
          float upper_soc = Discharge_Curve[i + 1];
          float lower_voltage = Discharge_Curve[i - 2];
          float upper_voltage = Discharge_Curve[i];

          float soc_slope = (upper_soc - lower_soc) / (upper_voltage - lower_voltage);
          SoC = int(2580 - lower_soc + soc_slope * (V_Measured_Battery - lower_voltage));  // Energy left

          Battery_Percentage = int((SoC / 2580) * 100);

          Serial.print("Battery Percentage: ");
          Serial.println(Battery_Percentage);

          break;
        }
      }
    }
  }
}
